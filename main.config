conda.enabled = true

params {
	// mlst
	mlst_header = "${projectDir}/resources/mlst_header.tsv"
	// resfinder
	resfinder_db = "${projectDir}/resources/resfinder_db"
	pointfinder_db = "${projectDir}/resources/pointfinder_db"
	resfinder_params = "-s \"Salmonella enterica\" -l 0.6 -t 0.9 -l_p 0.6 -t_p 0.9"
	// spifinder
	spifinder_db = "${projectDir}/resources/spifinder_db"
	spifinder_py = "${projectDir}/resources/spifinder/spifinder.py"
	spifinder_params = "-l 0.6 -t 0.9 -x"
	// abricate
	abricate_params = "--db vfdb"
	// seqsero2
	seqsero_params = "-m k -t 4"
	// mobsuite
	mobsuite_params = "-f --min_con_cov 90 --min_mob_cov 90 --min_rep_cov 90"
}
process {
	cpus = 1
	withLabel: process_low {
		cpus = 1
	}
	withLabel: process_medium {
		cpus = 48
	}
	withLabel: abricate {
		conda = "bioconda::abricate=1.4.0"
	}
	withName: RESFINDER {
		conda = "bioconda::resfinder=4.7.2"
	}
	withName: SPIFINDER {
		conda = "bioconda::blast=2.17.0 bioconda::cgecore=2.0.1 conda-forge::python=3.13.7 conda-forge::setuptools=80.9.0 conda-forge::tabulate=0.9.0"
	}
	withName: SEQSERO2 {
		conda = "bioconda::seqsero2=1.3.2"
	}
	withName: MOBSUITE {
		conda = "bioconda::mob_suite=3.1.9"
	}
	withName: GENERATESUMMARY {
		conda = "conda-forge::pandas=2.2.3 conda-forge::openpyxl=3.1.0"
	}
}
